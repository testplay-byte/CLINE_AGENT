/coverage

# next.js
/.next/
/out/

# production
/build

# Electron build output
/release/
/dist/electron/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
server.log

test
prompt

# Skills directory
/skills/

# Cline source (cloned for analysis, not part of our app)
/cline-source/

# Knowledge base working files
/knowledge-base/

# Upload files (user uploaded designs, not part of our app)
/upload/
/download/

# GitHub token and credentials
.env.local
.env.*.local

# Tool results (temporary analysis files)
/tool-results/

# Screenshots (temporary)
screenshot-*.png

# Agent context (working files, already tracked separately)
# /AGENT-CONTEXT/ — kept for repo visibility

# Database files
*.db
*.db-journal
/db/

# Bun lock file (regenerated on install)
# bun.lock — keep this, it ensures reproducible builds

# Temp files
--timeout
*.tmp
